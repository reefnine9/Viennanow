{
  "name": "viennanow-cloudflare",
  "version": "0.24.1",
  "private": true,
  "type": "module",
  "description": "ViennaNow five-tab Vienna travel guide; Cloudflare Pages with Pages Functions and GitHub CI",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-cloudflare.mjs",
    "dev": "wrangler pages dev public",
    "deploy:manual": "wrangler pages deploy public --project-name viennanow",
    "check:stores": "node scripts/check-store-readiness.mjs",
    "native:add:ios": "cap add ios",
    "native:add:android": "cap add android",
    "native:sync": "npm run native:build:web && cap sync",
    "native:open:ios": "cap open ios",
    "native:open:android": "cap open android",
    "native:build:web": "node scripts/build-native.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "check:native:release": "node scripts/check-native-release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "@capacitor/cli": "^7.0.0",
    "sharp": "^0.34.0"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  }
}
