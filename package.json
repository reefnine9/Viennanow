{
  "name": "viennanow-cloudflare",
  "version": "0.24.1",
  "private": true,
  "type": "module",
  "description": "ViennaNow five-tab Vienna travel guide; Cloudflare Pages with Pages Functions and GitHub CI",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-cloudflare.mjs",
